{
  "name": "oche",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sprachgesteuerter Darts-Scorer als PWA",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:phone": "vite preview --host --mode https",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=desktop --project=phone --project=phone-landscape --project=iphone && npm run e2e:voice",
    "e2e:voice": "playwright test --project=voice --workers=1",
    "model": "node scripts/fetch-model.mjs",
    "vosk": "node scripts/copy-vosk.mjs",
    "test-audio": "sh scripts/make-test-audio.sh",
    "postinstall": "node scripts/copy-vosk.mjs"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@lichess-org/vosk-browser": "^0.0.3",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
